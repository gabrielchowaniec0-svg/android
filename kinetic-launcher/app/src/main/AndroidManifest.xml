<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Swipe down anywhere on the home screen opens the notification shade. Normal, auto-granted. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Smart search can show matching contacts. Asked for only when you first use it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Focus modes can switch Do Not Disturb (you allow it once in Settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Kinetic Commands: "call Mom" calls straight away (asked the first time), "timer 10 min" / "alarm 7am". -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Optional "Usage access": lets Commands pick the app you use most for each job. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Focus schedules survive a restart; "Driving" can start when car Bluetooth connects. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Focus places ("School turns on at school"): asked only if you set a place. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- In-app updater: checks GitHub for a new build and installs it (you confirm). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Plane spotter: the live camera view behind the flight labels. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Commands: "when's my dentist appointment", "text mom running late" (send). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Vault: pick photos/videos to move in (and remove the originals). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ package visibility: see every launchable app and every widget provider. -->
    <queries>
        <!-- Kinetic Commands: find which apps can text, email, play music or navigate. -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="com.sec.android.app.samsungmaps" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Smart search: open web links (chowaniec.net pages) and web searches. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_kinetic"
        android:roundIcon="@drawable/ic_kinetic"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kinetic">

        <!--
            MAIN + LAUNCHER: makes this the run target in Android Studio and shows it in the app drawer.
            HOME + DEFAULT:  makes it selectable as the phone's Home app.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Kinetic.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Wallpaper studio: styles, colours, speed… with a live preview. -->
        <activity
            android:name=".WallpaperStudioActivity"
            android:exported="false"
            android:label="Wallpaper"
            android:theme="@style/Theme.Kinetic" />

        <!-- Focus picker (also opened by long-pressing the Focus quick-settings tile). -->
        <activity
            android:name=".FocusActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Focus"
            android:theme="@style/Theme.Kinetic.Sheet">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Focus schedules: the alarm for the next start/end, and re-planning after a restart. -->
        <receiver
            android:name=".FocusScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Focus places: arriving at / leaving a place. -->
        <receiver
            android:name=".FocusPlaceReceiver"
            android:exported="false" />

        <!-- "Driving" Focus: turns on when car Bluetooth connects. -->
        <receiver
            android:name=".FocusCarReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Plane spotter: point at a plane to see its flight. -->
        <activity
            android:name=".planes.PlaneSpotterActivity"
            android:exported="false"
            android:label="Plane spotter"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kinetic" />

        <!-- Encrypted Vault (Kinetic code only; no screenshots or recents preview). -->
        <activity
            android:name=".vault.VaultActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Vault"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kinetic" />

        <!-- Lets the camera save a Vault photo straight into Kinetic's private space. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.vaultfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vault_paths" />
        </provider>

        <!-- Result of installing an update. -->
        <receiver
            android:name=".UpdateResultReceiver"
            android:exported="false" />

        <!-- "Focus" tile in the quick-settings panel. -->
        <service
            android:name=".FocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_focus"
            android:label="Focus"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Kinetic settings (app list ▸ ⋮ ▸ Kinetic settings, or Settings in edit mode). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Kinetic settings"
            android:theme="@style/Theme.Kinetic" />

        <!--
            Notification rings: lets Kinetic see WHICH apps have notifications (nothing
            else is read or stored). You switch it on in Settings ▸ Notification access.
        -->
        <service
            android:name=".KineticNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Dynamic Island. Android only lets accessibility services draw above the
            status bar, so the island is one; it doesn't read the screen. Switch it on
            in Settings ▸ Accessibility ▸ Installed apps ▸ Kinetic Dynamic Island.
        -->
        <service
            android:name=".island.DynamicIslandService"
            android:exported="true"
            android:label="@string/island_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_accessibility" />
        </service>

    </application>
</manifest>
