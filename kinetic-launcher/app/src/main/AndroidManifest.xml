<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the launcher see other apps' launcher entries (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_kinetic"
        android:roundIcon="@drawable/ic_kinetic"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kinetic">

        <!--
            MAIN + LAUNCHER: makes this the run target in Android Studio and shows it in the app drawer.
            HOME + DEFAULT:  makes it selectable as the phone's Home app.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Kinetic.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>
</manifest>
