<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Swipe down anywhere on the home screen opens the notification shade. Normal, auto-granted. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Smart search can show matching contacts. Asked for only when you first use it. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 11+ package visibility: see every launchable app and every widget provider. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Smart search: open web links (chowaniec.net pages) and web searches. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_kinetic"
        android:roundIcon="@drawable/ic_kinetic"
        android:label="@string/app_name"
        android:theme="@style/Theme.Kinetic">

        <!--
            MAIN + LAUNCHER: makes this the run target in Android Studio and shows it in the app drawer.
            HOME + DEFAULT:  makes it selectable as the phone's Home app.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Kinetic.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Kinetic settings (app list ▸ ⋮ ▸ Kinetic settings, or Settings in edit mode). -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Kinetic settings"
            android:theme="@style/Theme.Kinetic" />

        <!--
            Notification rings: lets Kinetic see WHICH apps have notifications (nothing
            else is read or stored). You switch it on in Settings ▸ Notification access.
        -->
        <service
            android:name=".KineticNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Dynamic Island. Android only lets accessibility services draw above the
            status bar, so the island is one; it doesn't read the screen. Switch it on
            in Settings ▸ Accessibility ▸ Installed apps ▸ Kinetic Dynamic Island.
        -->
        <service
            android:name=".island.DynamicIslandService"
            android:exported="true"
            android:label="@string/island_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/island_accessibility" />
        </service>

    </application>
</manifest>
