<?xml version="1.0" encoding="utf-8"?>
<!-- App module manifest. Merge the relevant pieces into your module manifests. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to publish a live wallpaper -->
    <uses-permission android:name="android.permission.BIND_WALLPAPER" />
    <!-- Querying installed apps to populate the grid (Android 11+ package visibility) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:label="Kinetic"
        android:theme="@style/Theme.Kinetic">

        <!-- The launcher itself: HOME + DEFAULT makes it selectable as a home app -->
        <activity
            android:name="com.kinetic.launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Kinetic.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The AGSL live wallpaper service -->
        <service
            android:name="com.kinetic.wallpaper.FluidWallpaperService"
            android:exported="true"
            android:label="Kinetic Fluid"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/fluid_wallpaper" />
        </service>

    </application>
</manifest>
